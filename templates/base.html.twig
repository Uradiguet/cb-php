<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Gestionnaire de Budget{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet" type="text/css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-base-200">
<div class="navbar bg-primary text-primary-content">
    <div class="container mx-auto">
        <div class="flex-1">
            <a class="btn btn-ghost text-xl" href="{{ path('app_dashboard') }}">
                <i class="fas fa-wallet me-2"></i>Budget Manager
            </a>
        </div>

        {% if app.user %}
            <div class="flex-none">
                <ul class="menu menu-horizontal px-1">
                    <li><a href="{{ path('app_dashboard') }}">
                            <i class="fas fa-tachometer-alt"></i>Tableau de bord
                        </a></li>
                    <li><a href="{{ path('app_transaction_index') }}">
                            <i class="fas fa-exchange-alt"></i>Transactions
                        </a></li>
                    <li><a href="{{ path('app_category_index') }}">
                            <i class="fas fa-tags"></i>Catégories
                        </a></li>
                    <li><a href="{{ path('app_budget_index') }}">
                            <i class="fas fa-chart-pie"></i>Budgets
                        </a></li>
                    <li>
                        <div class="dropdown dropdown-end">
                            <div tabindex="0" role="button" class="btn btn-ghost">
                                <i class="fas fa-user"></i>{{ app.user.name }}
                            </div>
                            <ul tabindex="0" class="dropdown-content menu bg-base-100 text-base-content rounded-box z-[1] w-52 p-2 shadow">
                                <li><a href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt"></i>Déconnexion</a></li>
                            </ul>
                        </div>
                    </li>
                </ul>
            </div>
        {% endif %}
    </div>
</div>

<div class="container mx-auto p-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'error' : (label == 'success' ? 'success' : 'info') }} mb-4">
                <span>{{ message }}</span>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</div>

{% block javascripts %}{% endblock %}
</body>
</html>